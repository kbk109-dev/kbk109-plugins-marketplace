{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/codegraph_subagent_guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/codegraph_search_gate.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
