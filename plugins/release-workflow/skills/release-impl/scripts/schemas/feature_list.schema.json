{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claudeCodeSkills.local/release-impl/feature_list.schema.json",
  "title": "release-impl feature_list.json",
  "description": "Task State Machine for one release version. Consumed and mutated by release-impl as tasks transition fail → pass | blocked.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "source",
    "notion_page",
    "notion_database",
    "created_at",
    "summary",
    "acceptance_criteria_hashes",
    "previous_context",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$",
      "description": "Normalized 'v{major.minor.patch}' form; input variants (0.9.0, V0.9.0) must be normalized before write."
    },
    "current_task_id": {
      "description": "Non-null only while a task is mid-flight. Set by the orchestrator when Generator starts and cleared after Evaluator reaches a terminal verdict (pass or blocked). Session resume reads this to know where to continue.",
      "type": ["string", "null"],
      "pattern": "^TASK-\\d{3,}$"
    },
    "implementation_root": {
      "description": "Optional sub-path (relative to project_root) where this release's implementation lives. Used in monorepos to scope Generator search and Evaluator command execution to a single package. null (or omitted) means 'whole project_root', which preserves backward compatibility with single-package repos.",
      "type": ["string", "null"]
    },
    "source": {
      "type": "string",
      "enum": [
        "release-plan/task_list.json",
        "notion-direct"
      ]
    },
    "notion_page": { "type": "string", "minLength": 1 },
    "notion_database": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 8 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pass", "fail", "blocked"],
      "properties": {
        "total":   { "type": "integer", "minimum": 0 },
        "pass":    { "type": "integer", "minimum": 0 },
        "fail":    { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "acceptance_criteria_hashes": {
      "type": "object",
      "description": "task_id → sha256 of the acceptance_criteria array at creation time. Immutable after creation; check_state_transition.py rejects mutations.",
      "patternProperties": {
        "^TASK-\\d{3,}$": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "previous_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "type", "source", "summary", "relevance"],
        "additionalProperties": false,
        "properties": {
          "version":   { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
          "type":      { "type": "string", "enum": ["blocked_task", "known_issue", "architecture_decision", "dependency"] },
          "source":    { "type": "string", "minLength": 1 },
          "summary":   { "type": "string", "minLength": 1 },
          "relevance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "acceptance_criteria",
        "status",
        "priority",
        "dependencies",
        "retry_count",
        "evaluator_feedback",
        "completed_at"
      ],
      "additionalProperties": true,
      "properties": {
        "id":    { "type": "string", "pattern": "^TASK-\\d{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "string",
          "enum": ["fail", "pass", "blocked", "in_progress"]
        },
        "priority": { "type": "integer", "minimum": 0 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^TASK-\\d{3,}$" }
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "evaluator_feedback": {
          "type": ["string", "null"]
        },
        "evaluator_feedback_history": {
          "description": "Append-only log of every evaluator_feedback string this task has accumulated, including [resolved:ISO] entries after blocked → fail unblocks. Lets future sessions see repeat-failure patterns without fishing through git log.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "completed_at": {
          "type": ["string", "null"]
        },
        "evidence_logs": {
          "description": "criterion index (as string) -> relative log path under {version_dir}/logs/{task_id}/. Populated by Evaluator at pass time; check_evidence_logs.py verifies the files actually exist.",
          "type": "object",
          "propertyNames": { "pattern": "^\\d+$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "description": "status==pass implies completed_at is a non-null ISO-ish string",
          "if":   { "properties": { "status": { "const": "pass" } } },
          "then": { "properties": { "completed_at": { "type": "string", "minLength": 8 } } }
        },
        {
          "description": "status==blocked implies retry_count is 2 (reached cap)",
          "if":   { "properties": { "status": { "const": "blocked" } } },
          "then": { "properties": { "retry_count": { "const": 2 } } }
        },
        {
          "description": "retry_count > 0 implies evaluator_feedback is a non-null string",
          "if":   { "properties": { "retry_count": { "minimum": 1 } } },
          "then": { "properties": { "evaluator_feedback": { "type": "string", "minLength": 1 } } }
        },
        {
          "description": "status==pass implies evidence_logs is populated (at least one criterion logged). check_evidence_logs.py verifies file existence separately.",
          "if":   { "properties": { "status": { "const": "pass" } } },
          "then": { "properties": { "evidence_logs": { "type": "object", "minProperties": 1 } }, "required": ["evidence_logs"] }
        }
      ]
    }
  }
}
