{
  "enabledPlugins": {
    "release-workflow@kbk109-plugins-marketplace": true,
    "project-conventions@kbk109-plugins-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit_agent_gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
